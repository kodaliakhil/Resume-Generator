<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{{personalInfo.name}}</title>

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: Arial, Helvetica, sans-serif;
        font-size: 10px;
        line-height: 1.25;
        color: #000;
        background: #fff;
        padding: 12px;
      }

      .resume {
        max-width: 850px;
        margin: 0 auto;
      }

      .header {
        text-align: center;
        margin-bottom: 8px;
      }

      .name {
        font-size: 22px;
        font-weight: 700;
        letter-spacing: 0.3px;
      }

      .contact {
        margin-top: 2px;
        font-size: 10px;
      }

      .section {
        margin-top: 8px;
      }

      .section-title {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        border-bottom: 1px solid #000;
        padding-bottom: 1px;
        margin-bottom: 4px;
      }

      .item {
        margin-bottom: 4px;
      }

      .item-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
      }

      .item-title {
        font-weight: 700;
        font-size: 11px;
      }

      .item-date {
        font-size: 10px;
      }

      .item-company {
        font-style: italic;
        margin-bottom: 1px;
      }

      .description {
        padding-left: 14px;
        margin-top: 2px;
      }

      .description li {
        margin-bottom: 1px;
        line-height: 1.2;
      }

      .skills {
        margin-bottom: 2px;
        line-height: 1.2;
      }

      ul {
        padding-left: 14px;
      }

      li {
        margin-bottom: 1px;
      }
    </style>
  </head>

  <body>

    <div class="resume">

      <header class="header">

        <div class="name">
          {{personalInfo.name}}
        </div>

        <div class="contact">
          {{contactLine}}
        </div>

      </header>

      {{#if summary}}
        <section class="section">

          <h2 class="section-title">
            Professional Summary
          </h2>

          <p>{{summary}}</p>

        </section>
      {{/if}}

      {{#if skillDomains.length}}
        <section class="section">
          <h2 class="section-title">
            Skills
          </h2>
          {{#each skillDomains}}
            <p class="skills">
              <strong>{{name}}</strong>:
              {{skills}}
            </p>
          {{/each}}
        </section>
      {{/if}}

      {{#if experience.length}}
        <section class="section">

          <h2 class="section-title">
            Experience
          </h2>

          {{#each experience}}
            <div class="item">

              <div class="item-header">

                <div class="item-title">
                  {{jobTitle}}
                </div>

                <div class="item-date">
                  {{startDate}}
                  -
                  {{endDate}}
                </div>

              </div>

              <div class="item-company">
                {{company}}
              </div>

              {{#if bulletPoints}}
                <ul class="description">

                  {{#each bulletPoints}}
                    <li>{{this}}</li>
                  {{/each}}

                </ul>
              {{/if}}

            </div>
          {{/each}}

        </section>
      {{/if}}

      {{#if projects.length}}
        <section class="section">

          <h2 class="section-title">
            Projects
          </h2>

          {{#each projects}}
            <div class="item">

              <div class="item-title">
                {{title}}
              </div>

              <div>
                {{description}}
              </div>

              <div>
                Technologies:
                {{technologies}}
              </div>

              {{#if projectLink}}
                <div>
                  {{projectLink}}
                </div>
              {{/if}}

            </div>
          {{/each}}

        </section>
      {{/if}}

      {{#if education.length}}
        <section class="section">

          <h2 class="section-title">
            Education
          </h2>

          {{#each education}}
            <div class="item">

              <div class="item-title">
                {{degree}}
              </div>

              <div class="item-company">
                {{institution}}
              </div>

              <div>
                Graduation Year:
                {{graduationYear}}
              </div>

            </div>
          {{/each}}

        </section>
      {{/if}}

      {{#if certifications.length}}
        <section class="section">

          <h2 class="section-title">
            Certifications
          </h2>

          {{#each certifications}}
            <div class="item">

              <div class="item-title">
                {{name}}
              </div>

              <div class="item-company">
                {{issuer}}
              </div>

              <div>
                {{year}}
              </div>

            </div>
          {{/each}}

        </section>
      {{/if}}

    </div>

  </body>
</html>